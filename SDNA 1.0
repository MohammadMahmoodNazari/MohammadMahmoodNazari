        'neon_red': '#ff4757', 'neon_blue': '#3742fa',
        'text_primary': '#ffffff', 'text_secondary': '#c8c8d8', 'text_tertiary': '#8888a0',
        'text_disabled': '#555566', 'border': '#3a3a55', 'border_focus': '#00f7ff',
        'success': '#00ff9d', 'error': '#ff4757', 'warning': '#ffeb3b',
