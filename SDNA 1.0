# Netmiko handling with proper error management
def install_netmiko():
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "netmiko", "--quiet"])
        return True
    except Exception as e:
        print(f"Failed to install netmiko: {e}")
        return False

try:
    from netmiko import ConnectHandler, NetmikoTimeoutException, NetmikoAuthenticationException
except ImportError:
    print("Netmiko not found. Installing...")
    if install_netmiko():
        from netmiko import ConnectHandler, NetmikoTimeoutException, NetmikoAuthenticationException
    else:
        messagebox.showerror("Error", "Failed to install required library 'netmiko'. Please install manually: pip install netmiko")
        sys.exit(1)

