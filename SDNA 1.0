            btn.bind('<Leave>', lambda e, b=btn: b.config(bg=self.colors['bg_input']))
            self.cmd_buttons.append((btn, label, cmd))
        custom_frame = tk.LabelFrame(cmds, text=" Custom Troubleshooting Commands ", bg=self.colors['bg_card'],
                                     fg=self.colors['neon_cyan'], font=('Segoe UI', 10, 'bold'), padx=10, pady=10)
