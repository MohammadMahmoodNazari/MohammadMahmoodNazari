            ("🔄 RIP Config", "show running-config | section router rip"),
            ("🛣️ Static Routes", "show running-config | include ^ip route"),
            ("📋 IP Protocols", "show ip protocols"),
            ("🔌 Interface Status", "show ip interface brief"),
            ("📊 VLAN Brief", "show vlan brief"),
        ]
        self.cmd_buttons = []
        for label, cmd in self.troubleshoot_cmds:
            btn = tk.Button(cmds, text=label, command=lambda c=cmd: self.run_troubleshoot_cmd(c),
