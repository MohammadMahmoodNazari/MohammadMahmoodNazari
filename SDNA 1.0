                                     bg=bar['bg'], fg=self.colors['text_tertiary'], font=('Segoe UI', 10, 'bold'))
        self.vendor_label.pack(side='right', padx=30)

    def show_panel(self, index):
        for panel in self.panels: panel.pack_forget()
        self.panels[index].pack(fill='both', expand=True)
        for i, (btn, color) in enumerate(self.nav_buttons):
            if i == index:
                btn.config(fg=self.colors[color], bg=self.colors['bg_card'])
            else:
                btn.config(fg=self.colors['text_secondary'], bg=self.colors['bg_secondary'])

    def log(self, msg, level="info"):
        if not hasattr(self, 'conn_log'): return
        self.conn_log.config(state='normal')
        timestamp = datetime.now().strftime("%H:%M:%S")
        colors_tag = {"info": self.colors['text_primary'], "success": self.colors['success'],
                      "error": self.colors['error'], "warning": self.colors['warning']}
        self.conn_log.tag_config(level, foreground=colors_tag.get(level, self.colors['text_primary']))
        self.conn_log.insert('end', f"[{timestamp}] {msg}\n", level)
        self.conn_log.see('end')
        self.conn_log.config(state='disabled')

    def connect_device(self):
        ip = self.entry_ip.get()
        port = self.entry_port.get() or "22"
        user = self.entry_user.get()
        pwd = self.entry_pass.get()
        enable = self.entry_enable.get()
        if not all([ip, user, pwd]):
            messagebox.showerror("Error", "Please fill in IP, Username and Password")
            return
        device = Device(ip=ip, username=user, password=pwd, enable_secret=enable, port=int(port))
        self.log(f"Connecting to {ip}...", "info")
        def connect_thread():
            success, msg = self.ssh.connect(device)
            self.root.after(0, lambda: self.handle_connection_result(success, msg, device))
        threading.Thread(target=connect_thread, daemon=True).start()

    def handle_connection_result(self, success, msg, device):
        if success:
            self.log(msg, "success")
            self.status_var.set("🟢 Connected")
            self.status_canvas.itemconfig(self.status_indicator, fill=self.colors['success'])
            self.btn_connect.config(state='disabled')
            self.btn_disconnect.config(state='normal')
            self.status_label.config(text=f"Connected: {device.hostname}")
        else:
            self.log(msg, "error")
            self.status_var.set("🔴 Failed")
            messagebox.showerror("Connection Failed", msg)

    def disconnect_device(self):
        self.ssh.disconnect()
        self.status_var.set("⚪ Disconnected")
        self.status_canvas.itemconfig(self.status_indicator, fill=self.colors['error'])
        self.btn_connect.config(state='normal')
        self.btn_disconnect.config(state='disabled')
        self.status_label.config(text="Ready | Waiting for connection")
        self.log("Disconnected", "warning")

    def check_connection(self):
        if not self.ssh.device or not self.ssh.device.is_connected:
            messagebox.showerror("Error", "Not connected to any device!")
            return False
        return True

    def exec_config(self, name, commands):
        if not self.check_connection(): return
        if not commands:
            messagebox.showwarning("Notice", "No commands to execute")
            return
        self.log(f"Applying {name}...", "info")
        def config_thread():
            success, output = self.ssh.config_set(commands)
            self.root.after(0, lambda: self.handle_config_result(success, output, name))
        threading.Thread(target=config_thread, daemon=True).start()

    def handle_config_result(self, success, output, name):
        if success:
            self.log(f"✅ {name} success", "success")
            self.show_output(f"\n{'='*50}\n{name} Output:\n{'='*50}\n{output}")
            messagebox.showinfo("Success", f"{name} configured successfully!")
        else:
            self.log(f"❌ {name} failed", "error")
            messagebox.showerror("Error", f"Failed: {output}")

    def show_output(self, text):
        self.troubleshoot_output.config(state='normal')
        self.troubleshoot_output.insert('end', text + "\n")
        self.troubleshoot_output.see('end')
        self.troubleshoot_output.config(state='disabled')


    def config_ospf(self):
        networks = [(n.get(), w.get(), a.get()) for n, w, a in self.ospf_networks if n.get().strip() and w.get().strip()]
        if not networks:
            messagebox.showerror("Error", "Please enter at least one network with wildcard mask")
            return
        cmds = CommandGenerator.configure_ospf(self.ospf_pid.get(), self.ospf_rid.get(), networks)
        self.exec_config("OSPF", cmds)

    def delete_ospf(self):
        pid = self.ospf_del_pid.get().strip()
        if not pid:
            messagebox.showerror("Error", "Please enter OSPF Process ID to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete OSPF process {pid}?"):
            cmds = CommandGenerator.delete_ospf(pid)
            self.exec_config("Delete OSPF", cmds)

    def delete_ospf_network(self):
        pid = self.ospf_del_net_pid.get().strip()
        net = self.ospf_del_net_net.get().strip()
        wild = self.ospf_del_net_wild.get().strip()
        area = self.ospf_del_net_area.get().strip()
        if not all([pid, net, wild]):
            messagebox.showerror("Error", "Please enter PID, Network, and Wildcard")
            return
        if messagebox.askyesno("Confirm Delete", f"Remove network {net} {wild} area {area} from OSPF {pid}?"):
            cmds = CommandGenerator.delete_ospf_network(pid, net, wild, area)
            self.exec_config("Delete OSPF Network", cmds)

    def delete_ospf_router_id(self):
        """Delete Router-ID from OSPF process"""
        pid = self.ospf_del_rid_pid.get().strip()
        if not pid:
            messagebox.showerror("Error", "Please enter OSPF Process ID")
            return
        if messagebox.askyesno("Confirm Delete", f"Remove Router-ID from OSPF process {pid}?"):
            cmds = CommandGenerator.delete_ospf_router_id(pid)
            self.exec_config("Delete OSPF Router-ID", cmds)

    # ==================== EIGRP ====================
    def config_eigrp(self):
        networks = [(n.get(), w.get()) for n, w in self.eigrp_networks if n.get().strip() and w.get().strip()]
        if not networks:
            messagebox.showerror("Error", "Please enter at least one network with wildcard mask")
            return
        cmds = CommandGenerator.configure_eigrp(self.eigrp_as.get(), networks, self.eigrp_no_auto.get())
        self.exec_config("EIGRP", cmds)

    def delete_eigrp(self):
        as_num = self.eigrp_del_as.get().strip()
        if not as_num:
            messagebox.showerror("Error", "Please enter EIGRP AS Number to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete EIGRP AS {as_num}?"):
            cmds = CommandGenerator.delete_eigrp(as_num)
            self.exec_config("Delete EIGRP", cmds)

    def delete_eigrp_network(self):
        as_num = self.eigrp_del_net_as.get().strip()
        net = self.eigrp_del_net_net.get().strip()
        wild = self.eigrp_del_net_wild.get().strip()
        if not all([as_num, net, wild]):
            messagebox.showerror("Error", "Please enter AS Number, Network, and Wildcard")
            return
        if messagebox.askyesno("Confirm Delete", f"Remove network {net} {wild} from EIGRP AS {as_num}?"):
            cmds = CommandGenerator.delete_eigrp_network(as_num, net, wild)
            self.exec_config("Delete EIGRP Network", cmds)

    # ==================== RIPv2 ====================
    def config_rip(self):
        networks = [n.get() for n in self.rip_networks if n.get().strip()]
        if not networks:
            messagebox.showerror("Error", "Please enter at least one network")
            return
        cmds = CommandGenerator.configure_rip(networks)
        self.exec_config("RIPv2", cmds)

    def delete_rip(self):
        if messagebox.askyesno("Confirm Delete", "Are you sure you want to delete the entire RIPv2 process?"):
            cmds = CommandGenerator.delete_rip()
            self.exec_config("Delete RIPv2", cmds)

    def delete_rip_network(self):
        net = self.rip_del_net.get().strip()
        if not net:
            messagebox.showerror("Error", "Please enter network to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Remove network {net} from RIPv2?"):
            cmds = CommandGenerator.delete_rip_network(net)
            self.exec_config("Delete RIPv2 Network", cmds)

    # ==================== STATIC (ATMCRCP Style) ====================
    def add_static_route(self):
        """Add route to Treeview table (ATMCRCP style)"""
        net = self.static_net.get().strip()
        mask = self.static_mask.get().strip()
        hop = self.static_hop.get().strip()
        if not net or not mask or not hop:
            messagebox.showerror("Error", "Please fill in Network, Mask, and Next-Hop")
            return
        self.static_tree.insert('', 'end', values=(net, mask, hop, ''))
        # Clear entries after adding
        self.static_net.clear()
        self.static_mask.clear()
        self.static_hop.clear()

    def config_static(self):
        """Apply static routes from Treeview (ATMCRCP style)"""
        if not self.check_connection(): return
        commands = []
        for item in self.static_tree.get_children():
            values = self.static_tree.item(item, 'values')
            if values[3] and values[3].strip():  # Exit interface specified
                commands.append(f"ip route {values[0]} {values[1]} {values[3]}")
            else:
                commands.append(f"ip route {values[0]} {values[1]} {values[2]}")
        if not commands:
            messagebox.showwarning("Notice", "No routes in the table to apply")
            return
        self.exec_config("Static Routes", commands)

    def delete_static(self):
        """Delete static routes (preserved from original)"""
        routes = [(n.get(), m.get(), h.get()) for n, m, h in self.static_del_routes if n.get().strip() and h.get().strip()]
        if not routes:
            messagebox.showerror("Error", "Please enter at least one route to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Delete {len(routes)} static route(s)?"):
            cmds = CommandGenerator.delete_static(routes)
            self.exec_config("Delete Static Routes", cmds)

    # ==================== DEFAULT (ATMCRCP Style) ====================
    def config_default(self):
        """Configure default route with Next-Hop OR Exit Interface (ATMCRCP style)"""
        gateway = self.default_gateway.get().strip()
        intf = self.default_intf.get().strip()
        if not gateway and not intf:
            messagebox.showerror("Error", "Enter default gateway or select exit interface")
            return
        cmds = CommandGenerator.configure_default(gateway, intf)
        self.exec_config("Default Route", cmds)

    def delete_default(self):
        """Delete default route with Next-Hop OR Exit Interface"""
        gateway = self.default_del_gateway.get().strip()
        intf = self.default_del_intf.get().strip()
        if not gateway and not intf:
            messagebox.showerror("Error", "Enter gateway or select exit interface to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Delete default route via {gateway or intf}?"):
            cmds = CommandGenerator.delete_default(gateway, intf)
            self.exec_config("Delete Default Route", cmds)

    # ==================== INTERFACE ====================
    def select_interface(self):
        intf = f"{self.intf_type.get()}{self.intf_num.get()}"
        self.current_interface = intf
        self.intf_label.config(text=f"Selected: {intf}", fg=self.colors['neon_cyan'])
        self.log(f"Interface selected: {intf}", "info")

    def intf_action(self, shutdown):
        if not self.current_interface:
            messagebox.showerror("Error", "Select interface first")
            return
        cmds = CommandGenerator.interface_shutdown(self.current_interface, shutdown)
        action = "Shutdown" if shutdown else "No Shutdown"
        self.exec_config(f"Interface {action}", cmds)

    def apply_intf_config(self):
        if not self.current_interface:
            messagebox.showerror("Error", "Select interface first")
            return
        cmds = CommandGenerator.configure_interface(self.current_interface, self.port_mode.get(),
                                                     self.intf_ip.get(), self.intf_mask.get(), self.access_vlan.get())
        self.exec_config("Interface Config", cmds)

    def remove_intf_ip(self):
        if not self.current_interface:
            messagebox.showerror("Error", "Select interface first")
            return
        ip = self.intf_del_ip.get().strip()
        mask = self.intf_del_mask.get().strip()
        if ip and mask:
            if messagebox.askyesno("Confirm Delete", f"Remove IP {ip} {mask} from {self.current_interface}?"):
                cmds = CommandGenerator.delete_interface_ip_specific(self.current_interface, ip, mask)
                self.exec_config("Remove Interface IP", cmds)
        else:
            if messagebox.askyesno("Confirm Delete", f"Remove all IP addresses from {self.current_interface}?"):
                cmds = CommandGenerator.delete_interface_ip(self.current_interface)
                self.exec_config("Remove Interface IP", cmds)

    def reset_intf(self):
        if not self.current_interface:
            messagebox.showerror("Error", "Select interface first")
            return
        if messagebox.askyesno("Confirm Reset", f"Reset {self.current_interface} to factory defaults?"):
            cmds = CommandGenerator.reset_interface(self.current_interface)
            self.exec_config("Reset Interface", cmds)

    # ==================== VLAN ====================
    def create_vlan(self):
        cmds = CommandGenerator.create_vlan(self.vlan_id.get(), self.vlan_name.get())
        self.exec_config(f"VLAN {self.vlan_id.get()}", cmds)

    def delete_vlan(self):
        vid = self.vlan_del_id.get().strip()
        if not vid:
            messagebox.showerror("Error", "Please enter VLAN ID to delete")
            return
        if messagebox.askyesno("Confirm Delete", f"Are you sure you want to delete VLAN {vid}?"):
            cmds = CommandGenerator.delete_vlan(vid)
            self.exec_config(f"Delete VLAN {vid}", cmds)

    def refresh_vlans(self):
        if not self.check_connection(): return
        cmd = "show vlan brief"
        success, output = self.ssh.execute(cmd)
        if success:
            self.vlan_list.delete(0, 'end')
            lines = output.split('\n')
            for line in lines[2:]:
                if line.strip(): self.vlan_list.insert('end', line.strip())
            self.log("VLAN list refreshed", "success")
        else:
            self.log("Failed to refresh VLANs", "error")

    # ==================== TROUBLESHOOTING ====================
    def run_troubleshoot_cmd(self, cmd):
        if not self.check_connection(): return
        def troubleshoot_thread():
            success, output = self.ssh.execute(cmd)
            self.root.after(0, lambda: self.update_troubleshoot_output(success, output, cmd))
        threading.Thread(target=troubleshoot_thread, daemon=True).start()

    def run_custom_cmd(self):
        cmd = self.custom_cmd.get().strip()
        if not cmd:
            messagebox.showerror("Error", "Please enter a command")
            return
        self.run_troubleshoot_cmd(cmd)

    def update_troubleshoot_output(self, success, output, cmd):
        self.troubleshoot_output.config(state='normal')
        self.troubleshoot_output.delete('1.0', 'end')
        self.troubleshoot_output.insert('1.0', f"Command: {cmd}\n{'='*60}\n\n{output if success else 'Error: ' + output}")
        self.troubleshoot_output.config(state='disabled')

    def save_config(self):
        if not self.check_connection(): return
        cmd = CommandGenerator.save_config()
        success, output = self.ssh.execute(cmd)
        if success:
            self.log("Configuration saved", "success")
            messagebox.showinfo("Success", "Configuration saved to device!")
        else:
            messagebox.showerror("Error", "Failed to save configuration")

    def save_all_configs(self):
        if not self.check_connection(): return
        device = self.ssh.device
        if not device:
            messagebox.showerror("Error", "No device connected")
            return
        save_dir = filedialog.askdirectory(title="Select Directory to Save Configs")
        if not save_dir: return
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        hostname = device.hostname if device.hostname else device.ip.replace(".", "_")
        try:
            self.log("Retrieving startup-config...", "info")
            success_start, startup_config = self.ssh.execute("show startup-config")
            self.log("Retrieving running-config...", "info")
            success_run, running_config = self.ssh.execute("show running-config")
            files_saved = []
            if success_start:
                startup_filename = os.path.join(save_dir, f"{hostname}_startup_config_{timestamp}.txt")
                with open(startup_filename, 'w', encoding='utf-8') as f:
                    f.write(f"=== STARTUP CONFIG ===\nDevice: {hostname} ({device.ip})\nTimestamp: {datetime.now().isoformat()}\n{'='*50}\n\n")
                    f.write(startup_config)
                files_saved.append(startup_filename)
                self.log(f"Startup config saved: {startup_filename}", "success")
            else:
                self.log("Failed to retrieve startup-config", "error")
            if success_run:
                running_filename = os.path.join(save_dir, f"{hostname}_running_config_{timestamp}.txt")
                with open(running_filename, 'w', encoding='utf-8') as f:
                    f.write(f"=== RUNNING CONFIG ===\nDevice: {hostname} ({device.ip})\nTimestamp: {datetime.now().isoformat()}\n{'='*50}\n\n")
                    f.write(running_config)
                files_saved.append(running_filename)
                self.log(f"Running config saved: {running_filename}", "success")
            else:
                self.log("Failed to retrieve running-config", "error")
            if files_saved:
                messagebox.showinfo("Success", f"Saved {len(files_saved)} configuration file(s) to:\n{save_dir}")
            else:
                messagebox.showerror("Error", "Failed to save any configuration files")
        except Exception as e:
            messagebox.showerror("Error", f"Error saving configs: {str(e)}")
            self.log(f"Save All Configs failed: {str(e)}", "error")


def main():
    root = tk.Tk()
    try:
        from ctypes import windll
        windll.shcore.SetProcessDpiAwareness(1)
    except: pass
    try: root.iconbitmap('network.ico')
    except: pass
    app = CiscoProApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()