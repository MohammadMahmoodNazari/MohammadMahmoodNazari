        tk.Label(save_frame, text="Save Startup & Running Configs to files", bg=save_frame['bg'],
                 fg=self.colors['text_secondary'], font=('Segoe UI', 9)).pack(anchor='w', pady=5)
        StyledButton(save_frame, "💾 SAVE ALL CONFIGS", self.save_all_configs, 'neon_green', 20).pack(fill='x', pady=5)
        StyledButton(cmds, "💾 SAVE RUNNING CONFIG (wr)", self.save_config, 'neon_blue', 20).pack(fill='x', pady=(15, 0))
        right = tk.Frame(content, bg=self.colors['bg_primary'])
        right.pack(side='right', fill='both', expand=True, padx=(15, 0))
        out_card = Card(right, "Command Output", "📈", 'neon_blue')
        out_card.outer.pack(fill='both', expand=True)
        self.troubleshoot_output = scrolledtext.ScrolledText(out_card, bg=self.colors['bg_primary'],
                                                             fg=self.colors['neon_green'], font=('Consolas', 11),
                                                             relief='flat', padx=15, pady=15)
        self.troubleshoot_output.pack(fill='both', expand=True, padx=2, pady=2)
        self.troubleshoot_output.insert('1.0', ">>> Troubleshooting ready...\n>>> Connect to a device and select a command.\n")
        self.troubleshoot_output.config(state='disabled')
